{
  "name": "signal-core",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:game": "npm run dev -w @signal-core/game-client",
    "build:game": "npm run build -w @signal-core/game-client",
    "typecheck": "npm run typecheck -w @signal-core/game-client",
    "test": "npm run test -w @signal-core/game-client"
  }
}
